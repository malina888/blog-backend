generator client {
  provider     = "prisma-client"
  output       = "../prisma/client"
  moduleFormat = "cjs"
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  content     String
  publishedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
